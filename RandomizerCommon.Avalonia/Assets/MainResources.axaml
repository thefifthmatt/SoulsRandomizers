<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
    <!-- To be used with MainStyles for specific elements -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="NeutralBack">LightGray</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessBack">LightGreen</SolidColorBrush>
            <SolidColorBrush x:Key="ErrorBack">LightPink</SolidColorBrush>
            <SolidColorBrush x:Key="ErrorText">DarkRed</SolidColorBrush>
            <SolidColorBrush x:Key="WorkingBack">LightYellow</SolidColorBrush>
            <!-- https://github.com/AvaloniaUI/Avalonia/blob/master/src/Avalonia.Themes.Fluent/Accents/FluentControlResources.xaml -->
            <!-- https://github.com/AvaloniaUI/Avalonia/blob/master/src/Avalonia.Themes.Fluent/Accents/BaseColorsPalette.xaml -->
            <!-- https://github.com/AvaloniaUI/Avalonia/blob/main/src/Avalonia.Themes.Simple/Accents/Base.xaml -->
            <SolidColorBrush x:Key="ExpanderContentBackground">#CCFFFFFF</SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderHeaderBackground">Thistle</SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderHeaderAccent">#e6dae6</SolidColorBrush>
            <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="ExpanderHeaderAccent" />
            <StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="ExpanderHeaderAccent" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="NeutralBack">DimGray</SolidColorBrush>
            <SolidColorBrush x:Key="SuccessBack">Green</SolidColorBrush>
            <SolidColorBrush x:Key="ErrorBack">DarkRed</SolidColorBrush>
            <SolidColorBrush x:Key="ErrorText">LightPink</SolidColorBrush>
            <SolidColorBrush x:Key="WorkingBack">Goldenrod</SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderContentBackground">#CC000000</SolidColorBrush>
            <!-- This was Indigo #3b0066 but it reminded me too much of Visual Studio -->
            <SolidColorBrush x:Key="ExpanderHeaderBackground">#22005a</SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderHeaderAccent">#1d004d</SolidColorBrush>
            <StaticResource x:Key="ExpanderHeaderBackgroundPointerOver" ResourceKey="ExpanderHeaderAccent" />
            <StaticResource x:Key="ExpanderHeaderBackgroundPressed" ResourceKey="ExpanderHeaderAccent" />
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrush">Black</SolidColorBrush>
            <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver">Black</SolidColorBrush>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Simple theme overrides -->
    <sys:Double x:Key="FontSizeNormal">14</sys:Double>

